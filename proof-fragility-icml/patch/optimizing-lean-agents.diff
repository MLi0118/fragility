+def _strip_reasoning_channels(content):
+    """Return just the final answer from a reasoning model's raw output.
+
+    gpt-oss emits OpenAI "harmony" channels: a long `analysis` chain-of-thought,
+    then the answer in a `final` channel, separated by the literal
+    `assistantfinal` once special tokens are decoded. Through the Together API
+    (their default `api: together`) the server splits these and returns only the
+    final content, so json.loads() worked directly.
+
+    Through LOCAL vLLM the offline LLM class returns the raw concatenation --
+    vLLM's --reasoning-parser only applies in OpenAI-server mode -- so the parser
+    meets 35k characters of reasoning prose at char 0 and fails with
+    "Expecting value: line 1 column 1 (char 0)" on every sample.
+
+    Also strips the markdown fence the model wraps the JSON in. No-ops on content
+    that is already clean, so the Together path is unaffected.
+    """
+    if not isinstance(content, str):
+        return content
+    marker = "assistantfinal"
+    if marker in content:
+        content = content.rsplit(marker, 1)[1]
+    content = content.strip()
+    if content.startswith("```"):
+        content = re.sub(r"^```[a-zA-Z]*\s*", "", content)
+        if content.rstrip().endswith("```"):
+            content = content.rstrip()[:-3]
+    return content.strip()
+
