+# One resident vLLM engine at a time. The prover builds a fresh APIQuery every
+# correction round; reusing the engine avoids a reload per round, and holding
+# at most one model is what lets all three fit a single 20 GB card in turn.
+_VLLM_CACHE = {}
+
+
+def release_vllm_models():
+    import gc
+    for key in list(_VLLM_CACHE):
+        llm = _VLLM_CACHE.pop(key)
+        # `del llm` alone leaves the EngineCore subprocess holding the memory
+        try:
+            llm.llm_engine.engine_core.shutdown()
+        except Exception:
+            pass
+        try:
+            del llm.llm_engine
+        except Exception:
+            pass
+        del llm
+    gc.collect()
+    try:
+        import torch
+        if torch.cuda.is_available():
+            torch.cuda.empty_cache()
+    except Exception:
+        pass
+
+
+def _vllm_key(model, llm_args):
+    return (model, tuple(sorted(llm_args.items())))
+
+
+def get_vllm_model(model, llm_args):
+    key = _vllm_key(model, llm_args)
+    if key not in _VLLM_CACHE:
+        release_vllm_models()
+        logger.info(f"Loading local vllm model `{model}` {llm_args}")
+        _VLLM_CACHE[key] = LLM(model=model, **llm_args)
+    return _VLLM_CACHE[key]
+
+
+class _OutputJournal:
+    """Append-only record of finished generations, so a run killed mid-batch
+    (vLLM can hang silently) resumes without regenerating what finished.
+
+    Enabled by PF_VLLM_JOURNAL=<path> for models whose name contains one of
+    PF_VLLM_JOURNAL_MODELS (comma-separated). Entries are keyed by prompt, and
+    identical prompts (breakdown samples) are a multiset: each entry answers
+    one occurrence, once per process."""
+
+    def __init__(self, path):
+        import hashlib
+        self._h = lambda model, prompt: hashlib.sha256(f"{model}\0{prompt}".encode()).hexdigest()
+        self.path, self.free = path, {}
+        if os.path.exists(path):
+            with open(path) as f:
+                for line in f:
+                    try:
+                        e = json.loads(line)
+                    except json.JSONDecodeError:
+                        continue  # torn last line from a kill
+                    self.free.setdefault(e["h"], []).append(e)
+            logger.info(f"Output journal {path}: {sum(map(len, self.free.values()))} saved generations")
+
+    def take(self, model, prompt):
+        entries = self.free.get(self._h(model, prompt))
+        return entries.pop(0) if entries else None
+
+    def add(self, model, prompt, text, inp, outp):
+        with open(self.path, "a") as f:
+            f.write(json.dumps({"h": self._h(model, prompt), "text": text, "inp": inp, "outp": outp}) + "\n")
+
+
+_JOURNAL = None
+
+
+def _journal_for(model):
+    global _JOURNAL
+    path = os.environ.get("PF_VLLM_JOURNAL")
+    models = [m for m in os.environ.get("PF_VLLM_JOURNAL_MODELS", "").split(",") if m]
+    if not path or not any(m in model for m in models):
+        return None
+    # PF_VLLM_JOURNAL_ROUND0=1: only the prover's first attempts go through the
+    # journal, so arms seeded with the same journal share them; repairs stay fresh.
+    if os.environ.get("PF_VLLM_JOURNAL_ROUND0") and os.environ.get("PF_PROVER_ROUND", "0") != "0":
+        return None
+    if _JOURNAL is None:
+        _JOURNAL = _OutputJournal(path)
+    return _JOURNAL
+
+
