+    def _prepare_cut_prompt(self, data, cut, repair_mode, tokenizer):
+        """Fresh-attempt prompt, with the assistant turn prefilled by the kept
+        prefix of the previous failure. No cut (no parseable body) means j = 0
+        on the statement itself, i.e. a full regeneration."""
+        from fragility.repair import prefill_for
+        formal_statement = data["lean4_code"].split(":= by")[0] + ":= by sorry"
+        prompt = self.base_template.format(formal_statement=formal_statement,
+                                           informal_prefix=data.get("informal_prefix", ""))
+        if cut:
+            head, body, j = cut
+        else:
+            head, body, j = data["lean4_code"].split(":= by")[0] + ":= by", [], 0
+        data["repair_cut"] = {"mode": repair_mode, "j": j, "n": len(body)}
+        messages = [{"role": "user", "content": prompt},
+                    {"role": "assistant", "content": prefill_for(head, body, j), "prefill": True}]
+        text = ""
+        if tokenizer:
+            text = tokenizer.apply_chat_template(messages[:1], tokenize=False, add_generation_prompt=True)
+            text += messages[1]["content"]
+        return text, messages
+
     def _compile(self, data_list, round_num=0):
         verbosity = self.global_config.get('verbosity', 3)
 
